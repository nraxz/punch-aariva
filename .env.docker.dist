# Copy to .env.docker and adjust values for local Docker.
# Used by: ./docker-start.sh  and  docker compose --env-file .env.docker ...

# Database
DATABASE_NAME=kimai
DATABASE_USER=kimai
DATABASE_PASSWORD=kimai
DATABASE_ROOT_PASSWORD=kimai
# Host port for DBeaver / local MySQL clients (maps to container 3306)
DATABASE_PORT=3307

# First admin user (username is always "admin")
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme

# App
APP_SECRET=change_this_to_something_unique
TRUSTED_HOSTS=^(localhost|127\.0\.0\.1)$
KIMAI_PORT=8001
MAILER_FROM=admin@example.com
MAILER_URL=null://localhost
