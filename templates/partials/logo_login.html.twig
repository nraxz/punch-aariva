{% set logo = config('theme.branding.logo') %}
{% set company = config('theme.branding.company')|default(constant('App\\Constants::SOFTWARE')) %}
{% if logo is not empty %}
    <img src="{{ logo }}" alt="{{ company }}" style="max-width: 280px; height: auto;">
{% elseif company is not empty %}
    <p class="mb-0">{{ company }}</p>
{% else %}
    <p class="mb-0">{{ get_title()|raw }}</p>
{% endif %}
<p class="text-secondary fs-5 fw-normal mt-2 mb-0">{{ constant('App\\Constants::TAGLINE') }}</p>
